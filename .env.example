# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
PORTAL_ORIGIN=https://your-portal-domain.com

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Local Docker setup: postgres:postgres@localhost:5432/somalinet
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/somalinet

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=SomaliNet Administrator
ADMIN_PHONE=0612345678
ADMIN_PASSWORD=change_this_to_a_long_random_password
JWT_EXPIRES_IN=7d
NODE_ENV=development

# ── MikroTik Router ───────────────────────────────────────────────────────────
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
MIKROTIK_PASS=your_router_password
MIKROTIK_HOTSPOT_SERVER=hotspot1   # name of your /ip hotspot server

# ── EVC Plus (Hormuud) ────────────────────────────────────────────────────────
EVC_API_URL=https://api.evcplus.com/v1
EVC_MERCHANT_ID=your_merchant_id
EVC_API_KEY=your_evc_api_key

# ── Zaad (Telesom) ────────────────────────────────────────────────────────────
ZAAD_API_URL=https://api.zaad.so/v1
ZAAD_MERCHANT_ID=your_merchant_id
ZAAD_API_KEY=your_zaad_api_key

# ── Sahal (Golis) ─────────────────────────────────────────────────────────────
SAHAL_API_URL=https://api.sahal.so/v1
SAHAL_MERCHANT_ID=your_merchant_id
SAHAL_API_KEY=your_sahal_api_key

# ── Webhook secret (to verify callbacks are genuine) ─────────────────────────
WEBHOOK_SECRET=change_this_too

# Webhook verification is fail-closed until the provider's official protocol is configured.
# Set each provider's mode only after confirming its official documentation and credentials.
EVC_WEBHOOK_MODE=disabled
EVC_WEBHOOK_SECRET=configure_from_provider
ZAAD_WEBHOOK_MODE=disabled
ZAAD_WEBHOOK_SECRET=configure_from_provider
SAHAL_WEBHOOK_MODE=disabled
SAHAL_WEBHOOK_SECRET=configure_from_provider
